NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only immutable auth user ID allowed to approve/reject public access requests.
# Never prefix this variable with NEXT_PUBLIC_.
JOEY_APPROVER_USER_ID=
NEXT_PUBLIC_BOOKING_LOCATION_REVIEW_ENABLED=true

# Browser-safe Google Maps key for Maps JavaScript API and Places UI loading.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Separate server-only key for Places verification and route estimates. Never prefix with NEXT_PUBLIC.
GOOGLE_MAPS_SERVER_API_KEY=
