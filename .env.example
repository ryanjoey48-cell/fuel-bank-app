# Production project ref (do not use for experimental Fleet SQL): hafoaurzfgkkwpvzedvd
# Staging candidate (owner approval required before switch): wpmnjfncaoogssgpqxek (EES Development)
# Prefer .env.staging.local for staging credentials. Never fall back to production silently.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# After owner approves a staging ref, set this to that exact project id for local DDL helpers.
# EES_APPROVED_STAGING_PROJECT_REF=wpmnjfncaoogssgpqxek


# Server-only Geoapify Free-plan key used by /api/locations/geocode.
# Never rename this to NEXT_PUBLIC_GEOAPIFY_API_KEY or commit a real key.
GEOAPIFY_API_KEY=

# Server-only immutable auth user ID allowed to approve/reject public access requests.
# Never prefix this variable with NEXT_PUBLIC_.
JOEY_APPROVER_USER_ID=
NEXT_PUBLIC_BOOKING_LOCATION_REVIEW_ENABLED=true

# Browser-safe Google Maps key for Maps JavaScript API and Places UI loading.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional licensed raster tile URL override for Leaflet maps (must include any required key).
# Leave unset to use the default OpenFreeMap vector basemap (no API key; commercial use allowed).
# Do not point this at tile.openstreetmap.org for production — OSMF rate-limits app traffic (HTTP 429).
# NEXT_PUBLIC_EES_MAP_TILE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=YOUR_CARTO_KEY
# Optional OpenFreeMap / MapLibre style override when raster override is unset.
# NEXT_PUBLIC_EES_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Separate server-only key for Places verification and route estimates. Never prefix with NEXT_PUBLIC.
GOOGLE_MAPS_SERVER_API_KEY=

# Server-only Forth GPS tracking credentials. Never prefix these values with NEXT_PUBLIC_.
FORTH_CLIENT_ID=
FORTH_CLIENT_SECRET=
FORTH_USERNAME=
FORTH_PASSWORD=
FORTH_SOURCE_TIME_ZONE=

# Opt into the verified DotNetOpenAuth password-grant + HTTP Basic request.
FORTH_TOKEN_REQUEST_PROFILE=

# V20 fleet operations. Keep monitoring and server test disabled until the
# location/pin and V20 database proposals are approved and installed.
EES_FLEET_MONITOR_ENABLED=false
EES_FLEET_MONITOR_SECRET=
EES_WEB_PUSH_TEST_ENABLED=false
EES_WEB_PUSH_VAPID_PUBLIC_KEY=
EES_WEB_PUSH_VAPID_PRIVATE_KEY=
EES_WEB_PUSH_VAPID_SUBJECT=

# Local Finance Centre four-section workspace (never set on Vercel Production)
NEXT_PUBLIC_EES_FINANCE_LOCAL_WORKSPACE=1

