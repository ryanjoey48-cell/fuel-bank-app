{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-build-v11/types/**/*.ts",
    ".next-build-v12/types/**/*.ts",
    ".next-build-v13/types/**/*.ts",
    ".next-build-v14/types/**/*.ts",
    ".next-build-v15/types/**/*.ts",
    ".next-build-v16/types/**/*.ts",
    ".next-build-v17/types/**/*.ts",
    ".next-build-v18/types/**/*.ts",
    ".next-build-v19/types/**/*.ts",
    ".next-build-v20/types/**/*.ts",
    ".next-build-v201/types/**/*.ts",
    ".next-desktop-layout-qa/types/**/*.ts",
    ".next-ees-rc-verify/types/**/*.ts",
    ".next-finance-fixture/types/**/*.ts",
    ".next-finance-phase3d/types/**/*.ts",
    ".next-finance-port3000-master/types/**/*.ts",
    ".next-finance-port3000/types/**/*.ts",
    ".next-finance-qa/types/**/*.ts",
    ".next-finance-v101-browser/types/**/*.ts",
    ".next-finance-v101-build-verified/types/**/*.ts",
    ".next-finance-v101-qa/types/**/*.ts",
    ".next-finance-v4-build/types/**/*.ts",
    ".next-finance-verify/types/**/*.ts",
    ".next-fixture-v201/types/**/*.ts",
    ".next-fleet-compact-ux/types/**/*.ts",
    ".next-fleet-v19-qa/types/**/*.ts",
    ".next-fleet-v20-qa/types/**/*.ts",
    ".next-fleet-v23-ux/types/**/*.ts",
    ".next-forth-466-map/types/**/*.ts",
    ".next-local-production/types/**/*.ts",
    ".next-main-integration/types/**/*.ts",
    ".next-maintenance-qa/types/**/*.ts",
    ".next-maintenance-qa/types/**/*.ts",
    ".next-master-recovery-retry/types/**/*.ts",
    ".next-release-gate/types/**/*.ts",
    ".next-staging-prep/types/**/*.ts",
    ".next-v21-1-proximity/types/**/*.ts",
    ".next-v21-2-smart-map/types/**/*.ts",
    ".next-v22-fleet-control/types/**/*.ts",
    ".next-v22-hardening/types/**/*.ts",
    ".next-v22-playback/types/**/*.ts",
    ".next-v23-journey/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-expenses-v11-approved-test/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".recovery",
    "_vehicle_performance_release",
    "_weekly_mileage_deploy_source"
  ]
}
