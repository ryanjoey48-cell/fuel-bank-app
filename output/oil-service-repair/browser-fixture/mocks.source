import React,{createContext,useContext,useState} from 'react';
import {translations} from '../../../lib/translations';
const Context=createContext(null);
export function FixtureProvider({children}){const[language,setLanguage]=useState('en');return <Context.Provider value={{language,t:translations[language]}}><button id="qa-language" onClick={()=>setLanguage(language==='en'?'th':'en')}>EN / TH</button>{children}</Context.Provider>}
export const useLanguage=()=>useContext(Context);
const reg='3ฒน-9565';
const vehicle={id:'149ff7dd-cc6c-46cc-8fd6-68ad9de8cd87',vehicle_reg:reg,registration:reg,vehicle_type:'FOUR_WHEEL_TRUCK',vehicle_name:'Buew vehicle',active:true};
const log=(id,date)=>({id,vehicle_id:vehicle.id,vehicle_reg:reg,service_type:'oil_change',service_date:date,odometer:354784,oil_change_odometer:354784,interval_km:10000,next_service_due_odometer:364784,created_at:'2026-10-11T18:30:00Z'});
let logs=[log('160dd57f-82a1-4834-a896-e9a7fa3d06bd','2026-09-05'),log('388afff7-6421-483b-a754-da56b2f1b0ca','2026-09-07'),log('ed4196f7-b1f5-4676-a438-ff06728c8b0f','2026-10-05')];
window.__oilQa={counts:{},deleted:[],mode:'ok',logs:()=>logs};
const read=async(name,value)=>{window.__oilQa.counts[name]=(window.__oilQa.counts[name]||0)+1;await new Promise(r=>setTimeout(r,80));return structuredClone(value)};
export const fetchDrivers=()=>read('drivers',[{id:'driver',name:'Buew',vehicle_reg:reg,active:true}]);
export const fetchVehicles=()=>read('vehicles',[vehicle]);
export const fetchWeeklyMileage=()=>read('mileage',[{id:'mileage',week_ending:'2026-10-11',vehicle_reg:reg,driver_id:'driver',driver:'Buew',odometer_reading:360000,mileage:360000,created_at:'2026-10-11T08:00:00Z'}]);
export const fetchOilChangeHistory=()=>read('history',logs);
export const fetchOilChangeBaselinesForVehicles=()=>read('baselines',[]);
export const clearDataReadCache=()=>{};
export const deleteOilChangeService=async({serviceLogId})=>{await new Promise(r=>setTimeout(r,120));if(window.__oilQa.mode==='fail')throw new Error('Supabase DELETE policy denied this record.');if(window.__oilQa.mode==='timeout')throw new Error('Request timed out. Reload history before retrying.');logs=logs.filter(log=>log.id!==serviceLogId);window.__oilQa.deleted.push(serviceLogId);window.dispatchEvent(new CustomEvent('fuel-bank:data-changed',{detail:{resource:'vehicle_service_logs',resources:['vehicle_service_logs','vehicles']}}));};
export const saveOilChangeService=async()=>{};export const saveWeeklyMileage=async()=>{};export const deleteWeeklyMileage=async()=>{};
export const supabase={auth:{getUser:async()=>({data:{user:null},error:null})}};
